<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:KUNAI.UI.Converters"
             x:Class="KUNAI.UI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:ConnectionStateToBrushConverter x:Key="StateBrush" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://KUNAI.UI/Styles/KunaiStyles.axaml" />
  </Application.Styles>
</Application>
